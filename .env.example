# Copy to .env and fill in. Every setting has a working default.

# Embedding provider: ollama (local, nothing leaves the machine) | openai | azure.
# Ingest and retrieval MUST use the same model — changing it means a rebuild.
# The corpus is public, but the QUERY is embedded on every search and a
# call-center query can carry member details; keep ollama to stay on-machine.
KB_EMBED_PROVIDER=ollama
KB_EMBED_MODEL=
KB_EMBED_BATCH=64
# OPENAI_API_KEY=sk-...
KB_OLLAMA_URL=http://localhost:11434

# Name the plan inside each chunk's embedded context. On by default: 18 plans
# describe the same obligations in near-identical language, so this is what
# keeps a citation attached to the right plan. Changing it requires a rebuild.
KB_PLAN_IN_CONTEXT=1

# Cookies for browser-enumerated sources (see plans/manifests/).
# KB_COOKIE_DHCS_APL=incap_ses_...
